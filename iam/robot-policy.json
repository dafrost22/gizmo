{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeAnyBedrockModel",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:*::foundation-model/*",
        "arn:aws:bedrock:*:*:inference-profile/*",
        "arn:aws:bedrock:*:*:application-inference-profile/*"
      ]
    },
    {
      "Sid": "InvokeGizmoAgents",
      "Effect": "Allow",
      "Action": "bedrock-agentcore:InvokeAgentRuntime",
      "Resource": [
        "arn:aws:bedrock-agentcore:us-east-1:*:runtime/gizmo_*",
        "arn:aws:bedrock-agentcore:us-east-1:*:runtime/gizmo_*/runtime-endpoint/*"
      ]
    }
  ]
}
